{
  "name": "multiplayer-dice-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:multiplayer-d-ts && npm run build:multiplayer && concurrently --kill-others npm:dev:*",
    "dev:multiplayer": "npm run build:multiplayer -- --watch",
    "dev:sveltekit": "vite dev --host",
    "dev:storybook": "storybook dev -p 6006 --no-open",
    "dev:redis": "node src/scripts/redis-server.ts",
    "build": "npm run build:multiplayer-d-ts && npm run build:multiplayer && vite build",
    "build:multiplayer": "esbuild src/lib/server/multiplayer.ts --bundle --tsconfig=tsconfig.esbuild.json --outfile=dist/multiplayer.js --platform=node --format=esm --external:redis --external:uuid --external:gravatar --external:jwt-decode --external:lodash-es --external:pino --external:pino-loki",
    "build:multiplayer-d-ts": "mkdir -p dist; cp src/multiplayer.d.ts dist/",
    "preview": "vite preview",
    "start": "node ./server.js",
    "lint": "node src/varlockSync.ts && concurrently -c \"#c596c7\",\"#676778\",\"#4b32c3\",\"#fafafa\" --kill-others-on-fail \"npm:lint:*\"",
    "lint:prettier": "prettier --check .",
    "lint:svelte-check": "svelte-check --fail-on-warnings --tsgo",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:stylelint": "stylelint --max-warnings=0 \"src/**/*.{css,svelte}\"",
    "format": "eslint --fix && stylelint --fix \"src/**/*.{css,svelte}\" && prettier --write .",
    "prepare": "husky || true",
    "test": "vitest --passWithNoTests run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0 --no-ignore",
      "sh -c 'tsc -p tsconfig.json --noEmit'"
    ],
    "*.(c)?js": [
      "eslint --max-warnings 0 --no-ignore"
    ],
    "*.svelte": [
      "svelte-check --fail-on-warnings --tsgo",
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-svelte-csf": "^5.1.3",
    "@storybook/sveltekit": "^10.6.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/gravatar": "^1.8.6",
    "@types/jwt-encode": "^1.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@7",
    "@varlock/vite-integration": "^1.5.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "fontaine": "^0.8.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jwt-encode": "^1.0.1",
    "lint-staged": "^17.5.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "svelte-check": "^4.7.6",
    "typescript": "6",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "svelte": "^5.57.1",
    "uuid": "^14.0.2",
    "varlock": "^1.20.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
